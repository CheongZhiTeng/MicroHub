{
  "expo": {
    "name": "MicroHub",
    "slug": "microhub",
    "scheme": "microhub",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-system-ui",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your MicroHub profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/favicon-b.png"
    },
    "icon": "./assets/brand/icon-b.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-b.png",
        "backgroundColor": "#101a30"
      }
    }
  }
}
