{
  "name": "microhub",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand && npm run test:web",
    "test:db": "node --test tests/database.test.mjs tests/homework.database.test.mjs tests/groups.database.test.mjs tests/homework-complete.database.test.mjs tests/announcements.database.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:db && npm run format:check",
    "test:web": "jest --config jest.web.config.js --runInBand",
    "build:pages": "node scripts/build-pages.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.0",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@expo/ngrok": "^4.1.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.0",
    "prettier": "^3.6.0",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.0"
  }
}
